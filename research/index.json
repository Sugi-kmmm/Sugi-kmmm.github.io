---
# research/<年>/*.md の全業績を1つの JSON にまとめる（GitHub Pages がビルド時に作る）．消さないでください．
# 項目（キー）を増やしたときは，下の keys にも追加してください．
layout: null
---
{% assign keys = "タイトル,種別,査読,著者,言語,掲載誌,巻号ページ,日付,出版社,表彰機関,関連業績,DOI,URL,PDF" | split: "," %}[{% assign sep = "" %}{% for p in site.pages %}{% assign head = p.path | slice: 0, 9 %}{% assign ext = p.name | split: "." | last %}{% if head == "research/" and ext == "md" %}{{ sep }}
{"file": {{ p.path | jsonify }}, "url": {{ p.url | jsonify }}, "data": { {% for k in keys %}{{ k | jsonify }}: {{ p[k] | jsonify }}{% unless forloop.last %}, {% endunless %}{% endfor %} }}{% assign sep = "," %}{% endif %}{% endfor %}
]
